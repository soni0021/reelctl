{
  "$defs": {
    "AsrBackend": {
      "description": "Which word timer produced [`EditDna::words`].",
      "enum": [
        "whisper_cpp",
        "silence_bursts"
      ],
      "type": "string"
    },
    "CurveStatus": {
      "description": "Whether [`ZoomCurves::curves`] was measured.",
      "oneOf": [
        {
          "const": "measured",
          "description": "The curves were fitted; an empty list means no zoom move was found.",
          "type": "string"
        },
        {
          "const": "unimplemented",
          "description": "The file is from a version before 4, which did not fit curves.",
          "type": "string"
        }
      ]
    },
    "Cut": {
      "description": "A detected scene change. `interval_ms` is the time since the previous cut,\nor since the start of the reel for the first cut.",
      "properties": {
        "frame_index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "interval_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scene_score": {
          "description": "FFmpeg scene score in `0..=1` for the scene-score detector.\nTransNetV2 would store its cut probability here.",
          "format": "double",
          "type": "number"
        },
        "time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "frame_index",
        "time_ms",
        "interval_ms",
        "scene_score"
      ],
      "type": "object"
    },
    "CutDetectorKind": {
      "description": "Which cut detector produced [`EditDna::cuts`].",
      "enum": [
        "ffmpeg_scene_score",
        "trans_net_v2"
      ],
      "type": "string"
    },
    "FrameSize": {
      "description": "Decoded frame size in pixels.",
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "PassStatus": {
      "description": "Pass 1b signals that are named in the blueprint and intentionally not computed.",
      "enum": [
        "unimplemented"
      ],
      "type": "string"
    },
    "PayoffWindow": {
      "description": "The 9 second payoff window and whether a cue was found inside 8–10 seconds.",
      "properties": {
        "cue_frame_index": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cue_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "has_cue": {
          "type": "boolean"
        },
        "marker_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window_end_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window_start_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "marker_ms",
        "window_start_ms",
        "window_end_ms",
        "has_cue"
      ],
      "type": "object"
    },
    "ShotHistogram": {
      "description": "Per-shot RGB summary. Bin values are fractions of the samples in the shot.",
      "properties": {
        "bins_b": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "bins_g": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "bins_r": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "end_frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "end_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mean_b": {
          "format": "double",
          "type": "number"
        },
        "mean_g": {
          "format": "double",
          "type": "number"
        },
        "mean_r": {
          "format": "double",
          "type": "number"
        },
        "shot_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_frame": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shot_index",
        "start_ms",
        "end_ms",
        "start_frame",
        "end_frame",
        "mean_r",
        "mean_g",
        "mean_b",
        "bins_r",
        "bins_g",
        "bins_b"
      ],
      "type": "object"
    },
    "SilenceGap": {
      "description": "A run of audio below the silence threshold.",
      "properties": {
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "end_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "duration_ms"
      ],
      "type": "object"
    },
    "StubbedPass": {
      "properties": {
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PassStatus"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    "VisualEvent": {
      "description": "A change inside a shot that is not a cut. `time_ms` and `frame_index` are\nthe first frame that shows the change in full, as for a cut. A field that\ndoes not apply to the kind is `null`.",
      "properties": {
        "area": {
          "description": "Changed share of the frame for `overlay_change`, `0..=1`. `null` for zooms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "center_x": {
          "description": "Fixed point of a zoom move as a share of the frame width, `0..=1`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "center_y": {
          "description": "Fixed point of a zoom move as a share of the frame height, `0..=1`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "frame_index": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/VisualEventKind"
        },
        "scale": {
          "description": "Factor between the picture before and after a zoom move. `null` for\n`overlay_change`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "time_ms",
        "frame_index",
        "kind"
      ],
      "type": "object"
    },
    "VisualEventKind": {
      "description": "What a [`VisualEvent`] is.",
      "oneOf": [
        {
          "const": "punch_in",
          "description": "A fast scale-up of the picture (`scale` above 1).",
          "type": "string"
        },
        {
          "const": "zoom_out",
          "description": "A fast scale-down of the picture (`scale` below 1).",
          "type": "string"
        },
        {
          "const": "overlay_change",
          "description": "A block of the frame changed and stayed changed (a caption, a graphic).",
          "type": "string"
        }
      ]
    },
    "Word": {
      "description": "One word, or one silence-delimited voiced burst when no whisper model was given.",
      "properties": {
        "end_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_ms",
        "end_ms"
      ],
      "type": "object"
    },
    "ZoomCurve": {
      "description": "The easing of one zoom move: `cubic-bezier(1/3, y1, 2/3, y2)` fitted to the\nscale measured at each frame of a [`VisualEvent`] of kind `punch_in` or\n`zoom_out`.",
      "properties": {
        "bezier": {
          "description": "`[x1, y1, x2, y2]` with `x1 = 1/3` and `x2 = 2/3`; `y1` and `y2` lie in\n`-0.5..=1.5` (above 1 for an overshoot). `null` when too few frames were\nmeasured to fit one (a one-frame snap).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "end_ms": {
          "description": "The frame where the picture has reached its final scale. This can be a\nlittle later than the event's `time_ms`, which is the first frame within\nthe noise floor of the last one.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "event_index": {
          "description": "Index into [`EditDna::visual_events`] of the move.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fit_rms": {
          "description": "Root mean square of the measured progress minus the curve, in units of\nprogress (0 at the start, 1 at the end). `null` when `bezier` is.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "from_scale": {
          "description": "The scale at `start_ms`, relative to itself: always 1.",
          "format": "double",
          "type": "number"
        },
        "samples": {
          "description": "Frames from `start_ms` to `end_ms`, both included.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "description": "The frame before the move (the anchor, or the last frame still within a\nhair of it), as measured.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "to_scale": {
          "description": "The total factor of the move, as in the event's `scale`.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "event_index",
        "start_ms",
        "end_ms",
        "from_scale",
        "to_scale",
        "samples"
      ],
      "type": "object"
    },
    "ZoomCurves": {
      "description": "Easing curves of the zoom moves. Version 3 and earlier files hold the stub\nthey always had (`unimplemented`) and read with an empty list.",
      "properties": {
        "curves": {
          "default": [],
          "description": "One entry per `punch_in` or `zoom_out` in `visual_events`, in order.",
          "items": {
            "$ref": "#/$defs/ZoomCurve"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CurveStatus"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Millisecond edit telemetry for one reel.",
  "properties": {
    "asr_backend": {
      "$ref": "#/$defs/AsrBackend"
    },
    "asr_ms": {
      "description": "Word timing. Not part of the structural budget.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "asr_note": {
      "type": "string"
    },
    "cube_lut": {
      "$ref": "#/$defs/StubbedPass"
    },
    "cut_detector": {
      "$ref": "#/$defs/CutDetectorKind"
    },
    "cut_detector_note": {
      "type": "string"
    },
    "cuts": {
      "items": {
        "$ref": "#/$defs/Cut"
      },
      "type": "array"
    },
    "decode_note": {
      "type": "string"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "fps": {
      "format": "double",
      "type": "number"
    },
    "frame_count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "frame_size": {
      "$ref": "#/$defs/FrameSize"
    },
    "integrated_lufs": {
      "format": "double",
      "type": "number"
    },
    "noise_floor_db": {
      "default": null,
      "description": "10th-percentile window level in dB, the noise-floor estimate. `null`\nwithout audio, and in version 1 files, which did not measure it.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "payoff_window": {
      "$ref": "#/$defs/PayoffWindow"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "shot_histograms": {
      "items": {
        "$ref": "#/$defs/ShotHistogram"
      },
      "type": "array"
    },
    "signal_ms": {
      "description": "Decode, cuts, silence, loudness, histograms, and the JSON write.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "silence_gaps": {
      "items": {
        "$ref": "#/$defs/SilenceGap"
      },
      "type": "array"
    },
    "silence_threshold_db": {
      "default": -40.0,
      "description": "Level in dB below which a 10 ms window counts as silent in this recording.\nA version 1 file, which has no such field, used a fixed -40 dBFS.",
      "format": "double",
      "type": "number"
    },
    "visual_events": {
      "default": [],
      "description": "Punch-ins, zoom-outs and overlay changes inside shots, in time order.\nEmpty in a version 1 or 2 file, which did not look for them.",
      "items": {
        "$ref": "#/$defs/VisualEvent"
      },
      "type": "array"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/Word"
      },
      "type": "array"
    },
    "words_per_minute": {
      "format": "double",
      "type": "number"
    },
    "zoom_curves": {
      "$ref": "#/$defs/ZoomCurves",
      "default": {
        "curves": [],
        "reason": "This file was written before zoom easing curves were measured (schema version 3 or earlier).",
        "status": "unimplemented"
      }
    }
  },
  "required": [
    "schema_version",
    "duration_ms",
    "fps",
    "frame_size",
    "frame_count",
    "cuts",
    "silence_gaps",
    "words",
    "words_per_minute",
    "integrated_lufs",
    "shot_histograms",
    "payoff_window",
    "signal_ms",
    "asr_ms",
    "cube_lut",
    "cut_detector",
    "cut_detector_note",
    "asr_backend",
    "asr_note",
    "decode_note"
  ],
  "title": "EditDna",
  "type": "object"
}
